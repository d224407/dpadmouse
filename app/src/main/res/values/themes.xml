<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Always dark: Theme.AppCompat (not DayNight) so dialogs, text fields and
         system widgets stay dark regardless of the device's night-mode setting. -->
    <style name="Theme.DpadMouse" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/md_surface</item>
        <item name="android:statusBarColor">@color/md_surface</item>
        <item name="android:navigationBarColor">@color/md_surface</item>
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorAccent">@color/md_primary</item>
        <item name="alertDialogTheme">@style/Theme.DpadMouse.Dialog</item>
    </style>

    <style name="Theme.DpadMouse.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorBackgroundFloating">@color/md_surface_container_high</item>
        <item name="colorAccent">@color/md_primary</item>
        <item name="android:textColorPrimary">@color/md_on_surface</item>
        <item name="android:textColorSecondary">@color/md_on_surface_variant</item>
    </style>
</resources>
